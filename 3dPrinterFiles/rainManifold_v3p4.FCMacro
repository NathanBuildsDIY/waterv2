barb3Orig.Placement = App.Placement(App.Vector(0,0,barb2Orig.BoundBox.ZMax), App.Rotation(0,0,0))
barb4Orig.Placement = App.Placement(App.Vector(0,0,barb3Orig.BoundBox.ZMax), App.Rotation(0,0,0))
