thicknessMiddle = 13
thicknessReachAcrossBottomManifold = 30
maniconnector = Part.makeBox(100,20,thicknessReachAcrossBottomManifold)
maniOutNubbinHeight = 26
maniInNubbinHeight = 27
maniInHeight = 21
maniOutHeight = 3.2
maniconnectorCut = Part.makeBox(maniconnector.BoundBox.XMax-6,maniconnector.BoundBox.YMax,maniconnector.BoundBox.ZMax)
maniconnectorCut.Placement = App.Placement(App.Vector(3,0,thicknessMiddle), App.Rotation(0,0,0))
maniconnector = maniconnector.cut(maniconnectorCut)
screwCut = Part.makeCylinder(2,thicknessMiddle)
screwCut.Placement = App.Placement(App.Vector(maniconnector.BoundBox.XMax/2,maniconnector.BoundBox.YMax/2,0), App.Rotation(0,0,0))
maniconnector = maniconnector.cut(screwCut)
maniMeasure = maniconnector.copy()
#add ends
maniInGrabber = Part.makeBox(maniInHeight+4,maniconnector.BoundBox.YMax,maniconnector.BoundBox.ZMax)
maniconnectorCut.Placement = App.Placement(App.Vector(4,0,4), App.Rotation(0,0,0))
maniInGrabber = maniInGrabber.cut(maniconnectorCut)
maniOutGrabber = Part.makeBox(maniOutHeight+2,maniconnector.BoundBox.YMax,6)
maniconnectorCut.Placement = App.Placement(App.Vector(0,0,0), App.Rotation(0,0,0)) #reset position
maniconnectorCut.Placement = App.Placement(App.Vector(-maniconnectorCut.BoundBox.XMax+maniOutHeight,0,2), App.Rotation(0,0,0))
maniOutGrabber = maniOutGrabber.cut(maniconnectorCut)
#add nubbins to grab onto the top and bottom mani
nubbin = Part.makeCylinder(2,maniconnector.BoundBox.YMax)
nubbin.Placement = App.Placement(App.Vector(0,0,maniInNubbinHeight), App.Rotation(0,0,-90))
maniconnector = maniconnector.fuse(nubbin)
nubbin.Placement = App.Placement(App.Vector(maniconnector.BoundBox.XMax,0,maniOutNubbinHeight), App.Rotation(0,0,-90))
maniconnector = maniconnector.fuse(nubbin)
#place ends and fuse
maniOutGrabber.Placement = App.Placement(App.Vector(maniMeasure.BoundBox.XMax,0,0), App.Rotation(0,0,0))
maniconnector = maniconnector.fuse(maniOutGrabber)
maniconnector.Placement = App.Placement(App.Vector(maniInGrabber.BoundBox.XMax,0,0), App.Rotation(0,0,0))
maniconnector = maniconnector.fuse(maniInGrabber)
maniconnector2 = maniconnector.copy()
maniconnector3 = maniconnector.copy()
maniconnector4 = maniconnector.copy()
maniconnector.Placement = App.Placement(App.Vector(150,125,0), App.Rotation(0,0,0))
maniconnector2.Placement = App.Placement(App.Vector(150,155,0), App.Rotation(0,0,0))
maniconnector3.Placement = App.Placement(App.Vector(150,185,0), App.Rotation(0,0,0))
maniconnector4.Placement = App.Placement(App.Vector(150,215,0), App.Rotation(0,0,0))

#output = maniconnector.fuse(maniconnector2).fuse(maniconnector3).fuse(maniconnector4)
#output = inputConnector
Part.show(output)

########now make the float to keep the inlet hose near the surface########
float = Part.makeSphere(30)
floatCut = Part.makeSphere(float.BoundBox.XMax-2)
float = float.cut(floatCut)
#weighted cage
rockCage = Part.makeBox(100,100,60)
rockCageCut = Part.makeBox(rockCage.BoundBox.XMax-8,rockCage.BoundBox.XMax-8,rockCage.BoundBox.ZMax)
rockCageCut.Placement = App.Placement(App.Vector(4,4,4), App.Rotation(0,0,0))
rockCage =rockCage.cut(rockCageCut)
#hose hoops to keep the host in place
hoseHolster = Part.makeCylinder(11,4)
hoseHolsterCut = Part.makeCylinder(hoseHolster.BoundBox.XMax-4,hoseHolster.BoundBox.ZMax)
hoseHolster = hoseHolster.cut(hoseHolsterCut)
hoseHolster2 = hoseHolster.copy()
hoseHolster3 = hoseHolster.copy()
hoseHolster.Placement = App.Placement(App.Vector(rockCage.BoundBox.XMax-4,rockCage.BoundBox.YMax/2,rockCage.BoundBox.ZMax+hoseHolster.BoundBox.XMax-4), App.Rotation(0,90,0))
hoseHolster2.Placement = App.Placement(App.Vector(rockCage.BoundBox.XMin,rockCage.BoundBox.YMax/2,rockCage.BoundBox.ZMax+hoseHolster2.BoundBox.XMax-4), App.Rotation(0,90,0))
rockCage = rockCage.fuse(hoseHolster).fuse(hoseHolster2)
connector = Part.makeBox(145,8,4)
connector.Placement = App.Placement(App.Vector(-float.BoundBox.XMax,rockCage.BoundBox.YMax/2-4,0), App.Rotation(0,0,0))
rockCage = rockCage.fuse(connector)
hoseHolster3.Placement = App.Placement(App.Vector(0,0,float.BoundBox.ZMax+hoseHolster3.BoundBox.XMax-4), App.Rotation(0,90,0))
float = float.fuse(hoseHolster3)
float.Placement = App.Placement(App.Vector(-float.BoundBox.XMax+2,rockCage.BoundBox.YMax/2,-float.BoundBox.ZMin), App.Rotation(0,0,0))
#small box to hold end of hose and filter debris from getting in
filter = Part.makeBox(20,20,20)
filterCut1 = Part.makeBox(filter.BoundBox.XMax-4,filter.BoundBox.XMax-4,filter.BoundBox.ZMax-4)
filterCut1.Placement = App.Placement(App.Vector(2,2,2), App.Rotation(0,0,0))
filter =filter.cut(filterCut1)
hoseHolsterCut.Placement = App.Placement(App.Vector(filter.BoundBox.XMax/2,filter.BoundBox.YMax/2,filter.BoundBox.ZMax-2), App.Rotation(0,0,0))
filter =filter.cut(hoseHolsterCut)
filterCut2 = Part.makeCylinder(1.5,2)
filterCut2.Placement = App.Placement(App.Vector(6,6,0), App.Rotation(0,0,0)); filter =filter.cut(filterCut2)
filterCut2.Placement = App.Placement(App.Vector(6,10,0), App.Rotation(0,0,0)); filter =filter.cut(filterCut2)
filterCut2.Placement = App.Placement(App.Vector(6,14,0), App.Rotation(0,0,0)); filter =filter.cut(filterCut2)
filterCut2.Placement = App.Placement(App.Vector(10,6,0), App.Rotation(0,0,0)); filter =filter.cut(filterCut2)
filterCut2.Placement = App.Placement(App.Vector(10,10,0), App.Rotation(0,0,0)); filter =filter.cut(filterCut2)
filterCut2.Placement = App.Placement(App.Vector(10,14,0), App.Rotation(0,0,0)); filter =filter.cut(filterCut2)
filterCut2.Placement = App.Placement(App.Vector(14,6,0), App.Rotation(0,0,0)); filter =filter.cut(filterCut2)
filterCut2.Placement = App.Placement(App.Vector(14,10,0), App.Rotation(0,0,0)); filter =filter.cut(filterCut2)
filterCut2.Placement = App.Placement(App.Vector(14,14,0), App.Rotation(0,0,0)); filter =filter.cut(filterCut2)
filter.Placement = App.Placement(App.Vector(connector.BoundBox.XMax,rockCage.BoundBox.YMax/2-filter.BoundBox.YMax/2,0), App.Rotation(0,0,0))
filter = filter.fuse(rockCage).fuse(float)
filter.Placement = App.Placement(App.Vector(190,255,0), App.Rotation(0,0,0))
filter = filter.fuse(arm).fuse(maniconnector).fuse(maniconnector2).fuse(maniconnector3).fuse(maniconnector4).fuse(outputConnector).fuse(inputConnector)
Part.show(filter)

'''
