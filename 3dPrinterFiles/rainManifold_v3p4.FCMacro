barbOut4.Placement = App.Placement(App.Vector(-(manifoldOut.BoundBox.XMax/1.41-tubeOutideRadius-.5),manifoldOut.BoundBox.YMax/1.41-tubeOutideRadius-.5,0), App.Rotation(0,0,0));
barbShadowCut.Placement = App.Placement(App.Vector(-(manifoldOut.BoundBox.XMax/1.41-tubeOutideRadius-.5),manifoldOut.BoundBox.YMax/1.41-tubeOutideRadius-.5,0), App.Rotation(0,0,0));manifoldOut = manifoldOut.cut(barbShadowCut)
barbOut5.Placement = App.Placement(App.Vector(manifoldOut.BoundBox.XMin+tubeOutideRadius+3,0,0), App.Rotation(0,0,0))
