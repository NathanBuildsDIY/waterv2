gardenHoseCut.Placement = App.Placement(App.Vector(0,0,3), App.Rotation(0,0,0))
gardenHose=gardenHose.cut(gardenHoseCut)
gardenHose=gardenHose.cut(irrigation1p4BarbCut)
if fastcompile == False:
  #make spring
  gardenHoseRadius = gardenHoseRadius + 0.05 #teh intersection of threads and inner cyl caused the inner cyl to dissapear on fuse. This doesn't intersect
  ghelix = Part.makeHelix(2.3,gardenHose.BoundBox.ZMax-3,gardenHoseRadius) #pitch, height, radius
  gthread_profile = Part.Wire(Part.makePolygon([App.Vector(gardenHoseRadius,0,0),App.Vector(gardenHoseRadius,0,2),App.Vector(gardenHoseRadius+1,0,1),App.Vector(gardenHoseRadius,0,0)]))
    #note this is a Part.wire, polygon i.e. W0 = Part.Wire([edge0, edge1, edge2]) where edge0=Part.makeLine(ps0,ps1)
    #refs - https://forum.freecad.org/viewtopic.php?t=65875    https://forum.freecad.org/viewtopic.php?t=51032
    #note we have to complete the app.vector triangle - 4 points total so it connects back wehre it starts.
  makeSolid = True; isFrenet = True; transition = 1; 
  gthreads = Part.Wire(ghelix).makePipeShell([gthread_profile],makeSolid,isFrenet)
  gardenHose.Placement=App.Placement(App.Vector(0,0,barbOut.BoundBox.ZMax), App.Rotation(0,0,0))
  gthreads.Placement=App.Placement(App.Vector(0,0,barbOut.BoundBox.ZMax), App.Rotation(0,0,0))
if fastcompile == False:
  barbOut = barbOut.fuse(gardenHose).fuse(irrigation1p4).fuse(gthreads)
else:
