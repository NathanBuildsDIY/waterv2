import Part
import math
from FreeCAD import Base

#v3 will use springs & compression of tubes to cut off flow
#v3.2 fuses in/out manifold into 1, prints on 45, adds base and mounts for everything.   Also has on/off switch for fast compile.
#v3.3 unfuses - the print kept slipping in X or Y and failing. too complex? Instead print separately in/out and clip together.
#VALUES#
fastcompile = False

#Create new document
App.newDocument("Manifold")
App.setActiveDocument("Manifold")
App.ActiveDocument=App.getDocument("Manifold")
Gui.ActiveDocument=Gui.getDocument("Manifold")

thickness = 2
shadowCutThickness = 1
loopThickness = 7

#loop to compress hose & shadow cut
left = Part.makeBox(70,loopThickness,loopThickness)
leftShadowCut = Part.makeBox(left.BoundBox.XMax,left.BoundBox.YMax+shadowCutThickness,left.BoundBox.ZMax+shadowCutThickness)
right = left.copy()
rightShadowCut = leftShadowCut.copy()
top = Part.makeBox(loopThickness,30,loopThickness)
topShadowCut = Part.makeBox(top.BoundBox.XMax+shadowCutThickness,top.BoundBox.YMax,top.BoundBox.ZMax+shadowCutThickness)
bottom = top.copy()
bottomExtra = Part.makeBox(top.BoundBox.XMax,top.BoundBox.YMax,top.BoundBox.ZMax*1.41) #flatten out the side the arm must push against
bottomShadowCut = topShadowCut.copy()
left.Placement = App.Placement(App.Vector(0,0,0), App.Rotation(0,0,45))
leftShadowCut.Placement = App.Placement(App.Vector(0,0,-shadowCutThickness*1.4/2), App.Rotation(0,0,45))
leftShadowCut2 = Part.makeBox(left.BoundBox.XMax,2,.2) #add a bit more shadow cut at the bottom of the left/right to avoid contact with the pipe.
leftShadowCut2.Placement = App.Placement(App.Vector(0,-1,0), App.Rotation(0,0,0))
leftShadowCut = leftShadowCut.fuse(leftShadowCut2)
bottom.Placement = App.Placement(App.Vector(loopThickness/1.4,0,0), App.Rotation(0,-45,0))
bottomExtra.Placement = App.Placement(App.Vector(bottom.BoundBox.XMin,bottom.BoundBox.YMin,0), App.Rotation(0,0,0))
bottom = bottom.fuse(bottomExtra)
bottomShadowCut.Placement = App.Placement(App.Vector(loopThickness/1.4,0,-shadowCutThickness*1.4/2), App.Rotation(0,-45,0))
top.Placement = App.Placement(App.Vector(left.BoundBox.XMax-loopThickness/1.4,0,0), App.Rotation(0,-45,0))
topShadowCut.Placement = App.Placement(App.Vector(left.BoundBox.XMax-loopThickness/1.4,0,-shadowCutThickness*1.4/2), App.Rotation(0,-45,0))
right.Placement = App.Placement(App.Vector(0,top.BoundBox.YMax,0), App.Rotation(0,0,45))
rightShadowCut.Placement = App.Placement(App.Vector(0,top.BoundBox.YMax,-shadowCutThickness*1.4/2), App.Rotation(0,0,45))
rightShadowCut2 = Part.makeBox(right.BoundBox.XMax,2,.2) #add a bit more shadow cut at the bottom of the left/right to avoid contact with the pipe.
rightShadowCut2.Placement = App.Placement(App.Vector(0,top.BoundBox.YMax-1,0), App.Rotation(0,0,0))
rightShadowCut = rightShadowCut.fuse(rightShadowCut2)

loop = bottom.fuse(left).fuse(right).fuse(top)
loopShadow = bottomShadowCut.fuse(leftShadowCut).fuse(rightShadowCut).fuse(topShadowCut)

#spring holder - Spring is Menardds 88259. 1/2x1-9/16 compression
springHolder = Part.makeCylinder(loopThickness/2*1.4-.5,15)
springHolder2= Part.makeCylinder(loopThickness/2*1.4-.5,10)
#springHolderShadowCut = Part.makeCylinder(springHolder.BoundBox.XMax+4,35)
springHolderShadowCut = Part.makeBox(35,springHolder.BoundBox.XMax*2+7,springHolder.BoundBox.XMax*2+4)
springHolder.Placement = App.Placement(App.Vector(0,top.BoundBox.YMax/2,loopThickness/2*1.4-.5), App.Rotation(0,90,0))
#springHolderShadowCut.Placement = App.Placement(App.Vector(0,top.BoundBox.YMax/2,loopThickness/2*1.4+2), App.Rotation(0,90,0))
springHolderShadowCut.Placement = App.Placement(App.Vector(2,top.BoundBox.YMax/2-springHolderShadowCut.BoundBox.YMax/2,0), App.Rotation(0,0,0))
springHolder2.Placement =  App.Placement(App.Vector(springHolderShadowCut.BoundBox.XMax-springHolder2.BoundBox.ZMax,top.BoundBox.YMax/2,loopThickness/2*1.4-.5), App.Rotation(0,90,0))

loop = loop.fuse(springHolder)

loopHolder = Part.makeBox(40,50,16)
loopHolder.Placement = App.Placement(App.Vector(loop.BoundBox.XMax-12-loopHolder.BoundBox.XMax,(loop.BoundBox.YMax-loop.BoundBox.YMin)-loopHolder.BoundBox.YMax,0), App.Rotation(0,0,0))
loopHolder = loopHolder.cut(springHolderShadowCut)
loopHolder = loopHolder.fuse(springHolder2)
loopHolder = loopHolder.cut(loopShadow)

loop = loop.fuse(loopHolder)

loop2=loop.copy()
loop3=loop.copy()
loop4=loop.copy()
loop5=loop.copy()
loop6=loop.copy()
loop7=loop.copy()

loop2.Placement = App.Placement(App.Vector(loop.BoundBox.XMin-4.5,loop.BoundBox.YMax-0.5,0), App.Rotation(45,0,0))
loop3.Placement = App.Placement(App.Vector(loop.BoundBox.XMin-35,loop.BoundBox.YMax+24,0), App.Rotation(90,0,0))
loop4.Placement = App.Placement(App.Vector(loop.BoundBox.XMin-74.5,loop.BoundBox.YMax+20.5,0), App.Rotation(135,0,0))
loop5.Placement = App.Placement(App.Vector(loop.BoundBox.XMin-100,(loop.BoundBox.YMax-loop.BoundBox.YMin)/2+5,0), App.Rotation(180,0,0))
loop6.Placement = App.Placement(App.Vector(loop.BoundBox.XMin-96,-loop.BoundBox.YMax+31,0), App.Rotation(-135,0,0))
loop7.Placement = App.Placement(App.Vector(loop.BoundBox.XMin-25,-loop.BoundBox.YMax+10,0), App.Rotation(-45,0,0))


#connectorLoop
loops = loop.fuse(loop2).fuse(loop3).fuse(loop4).fuse(loop5).fuse(loop6).fuse(loop7)
connectorLoop = Part.makeCylinder((loops.BoundBox.XMax-loops.BoundBox.XMin)*2.35/5,loops.BoundBox.ZMax)
connectorLoopCut = Part.makeCylinder((loops.BoundBox.XMax-loops.BoundBox.XMin)*1.55/5,loops.BoundBox.ZMax)
connectorLoop = connectorLoop.cut(connectorLoopCut)
connectorLoop.Placement = App.Placement(App.Vector((loops.BoundBox.XMax+loops.BoundBox.XMin)/2,10,0), App.Rotation(0,0,0))
connectorLoopCut2 = Part.makeBox(1000,1000,1000)
connectorLoopCut2.Placement = App.Placement(App.Vector(-500,loop.BoundBox.YMax-connectorLoopCut2.BoundBox.YMax,0), App.Rotation(0,0,0))
connectorLoopCut3 = Part.makeBox(loop.BoundBox.YMax-loop.BoundBox.YMin,200,loop.BoundBox.ZMax)
connectorLoopCut3.Placement = App.Placement(App.Vector((loop3.BoundBox.XMax+loop3.BoundBox.XMin)/2-connectorLoopCut3.BoundBox.XMax/2,0,0), App.Rotation(0,0,0))
connectorLoop = connectorLoop.cut(connectorLoopCut2)
connectorLoop = connectorLoop.cut(connectorLoopCut3)
connectorLoopCut3 = Part.makeBox(loop.BoundBox.YMax-loop.BoundBox.YMin-1,200,loop.BoundBox.ZMax) #remake just smaller x for angle cuts
connectorLoopCut3.Placement = App.Placement(App.Vector((loop3.BoundBox.XMax+loop3.BoundBox.XMin)/2-connectorLoopCut3.BoundBox.XMax/2,25,0), App.Rotation(-45,0,0))
connectorLoop = connectorLoop.cut(connectorLoopCut3)
connectorLoopCut3.Placement = App.Placement(App.Vector((loop3.BoundBox.XMax+loop3.BoundBox.XMin)/2-connectorLoopCut3.BoundBox.XMax/2,31,0), App.Rotation(45,0,0))
connectorLoop = connectorLoop.cut(connectorLoopCut3)
#connectorLoop2 - below
connectorLoop2 = Part.makeCylinder((loops.BoundBox.XMax-loops.BoundBox.XMin)*2.35/5,loops.BoundBox.ZMax)
connectorLoopCut2 = Part.makeCylinder((loops.BoundBox.XMax-loops.BoundBox.XMin)*1.55/5,loops.BoundBox.ZMax)
connectorLoop2 = connectorLoop2.cut(connectorLoopCut2)
connectorLoop2.Placement = App.Placement(App.Vector((loops.BoundBox.XMax+loops.BoundBox.XMin)/2,20,0), App.Rotation(0,0,0))
connectorLoopCut2 = Part.makeBox(1000,1000,1000)
connectorLoopCut2.Placement = App.Placement(App.Vector(-500,loop.BoundBox.YMin+1,0), App.Rotation(0,0,0))
connectorLoop2 = connectorLoop2.cut(connectorLoopCut2)
connectorLoopCut3.Placement = App.Placement(App.Vector((loop3.BoundBox.XMax+loop3.BoundBox.XMin)/2-connectorLoopCut3.BoundBox.XMax/2,15,0), App.Rotation(135,0,0))
connectorLoop2 = connectorLoop2.cut(connectorLoopCut3)
connectorLoopCut3.Placement = App.Placement(App.Vector((loop3.BoundBox.XMax+loop3.BoundBox.XMin)/2-connectorLoopCut3.BoundBox.XMax/2,42,0), App.Rotation(-135,0,0))
connectorLoop2 = connectorLoop2.cut(connectorLoopCut3)
#help the wires from top manifold to bottom manifold - power and signal
wireCut = Part.makeCylinder(3,20)
wireCut.Placement = App.Placement(App.Vector((loops.BoundBox.XMax+loops.BoundBox.XMin)/2+0,loops.BoundBox.YMin+10,0), App.Rotation(0,0,0))
connectorLoop2 = connectorLoop2.cut(wireCut)
wireCut.Placement = App.Placement(App.Vector((loops.BoundBox.XMax+loops.BoundBox.XMin)/2+9,loops.BoundBox.YMin+15,0), App.Rotation(0,0,0))
connectorLoop2 = connectorLoop2.cut(wireCut)
wireCut.Placement = App.Placement(App.Vector((loops.BoundBox.XMax+loops.BoundBox.XMin)/2-9,loops.BoundBox.YMin+15,0), App.Rotation(0,0,0))
connectorLoop2 = connectorLoop2.cut(wireCut)
#Put screw holes in connector loop between loops to secure to manifold later
radius = 1.7; height = 200; pitch = 1.2
cylinder = Part.makeCylinder(radius,height)
cylinder.Placement=App.Placement(App.Vector((loops.BoundBox.XMax+loops.BoundBox.XMin)/2,(loops.BoundBox.YMax+loops.BoundBox.YMin)/2,connectorLoop.BoundBox.ZMax/2), App.Rotation(45/2,90,0))
connectorLoop = connectorLoop.cut(cylinder)
cylinder.Placement=App.Placement(App.Vector((loops.BoundBox.XMax+loops.BoundBox.XMin)/2,(loops.BoundBox.YMax+loops.BoundBox.YMin)/2,connectorLoop.BoundBox.ZMax/2), App.Rotation(45/2+45,90,0))
connectorLoop = connectorLoop.cut(cylinder)
cylinder.Placement=App.Placement(App.Vector((loops.BoundBox.XMax+loops.BoundBox.XMin)/2,(loops.BoundBox.YMax+loops.BoundBox.YMin)/2,connectorLoop.BoundBox.ZMax/2), App.Rotation(45/2+90,90,0))
connectorLoop = connectorLoop.cut(cylinder)
cylinder.Placement=App.Placement(App.Vector((loops.BoundBox.XMax+loops.BoundBox.XMin)/2,(loops.BoundBox.YMax+loops.BoundBox.YMin)/2,connectorLoop.BoundBox.ZMax/2), App.Rotation(45/2+135,90,0))
connectorLoop = connectorLoop.cut(cylinder)
cylinder.Placement=App.Placement(App.Vector((loops.BoundBox.XMax+loops.BoundBox.XMin)/2,(loops.BoundBox.YMax+loops.BoundBox.YMin)/2,connectorLoop.BoundBox.ZMax/2), App.Rotation(-45/2,90,0))
connectorLoop2 = connectorLoop2.cut(cylinder)
cylinder.Placement=App.Placement(App.Vector((loops.BoundBox.XMax+loops.BoundBox.XMin)/2,(loops.BoundBox.YMax+loops.BoundBox.YMin)/2,connectorLoop.BoundBox.ZMax/2), App.Rotation(-45/2-45,90,0))
connectorLoop2 = connectorLoop2.cut(cylinder)
cylinder.Placement=App.Placement(App.Vector((loops.BoundBox.XMax+loops.BoundBox.XMin)/2,(loops.BoundBox.YMax+loops.BoundBox.YMin)/2,connectorLoop.BoundBox.ZMax/2), App.Rotation(-45/2-90,90,0))
connectorLoop2 = connectorLoop2.cut(cylinder)
cylinder.Placement=App.Placement(App.Vector((loops.BoundBox.XMax+loops.BoundBox.XMin)/2,(loops.BoundBox.YMax+loops.BoundBox.YMin)/2,connectorLoop.BoundBox.ZMax/2), App.Rotation(-45/2-135,90,0))
connectorLoop2 = connectorLoop2.cut(cylinder)

#make the servo motor holder
motorHarness = Part.makeCylinder(30,8)
motorHarnessShadow = motorHarness.copy()
motorHarnessCut = Part.makeBox(21,41,motorHarness.BoundBox.ZMax)
motorHarnessCut.Placement =  App.Placement(App.Vector(-motorHarnessCut.BoundBox.XMax/2,-motorHarnessCut.BoundBox.YMax/2,0), App.Rotation(0,0,0))
motorHarness = motorHarness.cut(motorHarnessCut)
screwCut = Part.makeCylinder(1.5,motorHarness.BoundBox.ZMax)
screwCut.Placement = App.Placement(App.Vector(5,49/2,0), App.Rotation(0,0,0))
motorHarness = motorHarness.cut(screwCut)
screwCut.Placement = App.Placement(App.Vector(-5,49/2,0), App.Rotation(0,0,0))
motorHarness = motorHarness.cut(screwCut)
screwCut.Placement = App.Placement(App.Vector(5,-49/2,0), App.Rotation(0,0,0))
motorHarness = motorHarness.cut(screwCut)
screwCut.Placement = App.Placement(App.Vector(-5,-49/2,0), App.Rotation(0,0,0))
motorHarness = motorHarness.cut(screwCut)
#cone to house motor Harness
cone = Part.makeCone(176/2,30,23)
coneCut = Part.makeCone(cone.BoundBox.XMax-9,30,cone.BoundBox.ZMax-motorHarness.BoundBox.ZMax)
cone = cone.cut(coneCut)
motorHarness.Placement = App.Placement(App.Vector(0,0,cone.BoundBox.ZMax-motorHarness.BoundBox.ZMax), App.Rotation(0,0,0))
motorHarnessShadow.Placement = App.Placement(App.Vector(0,0,cone.BoundBox.ZMax-motorHarnessShadow.BoundBox.ZMax), App.Rotation(0,0,0))
cone = cone.cut(motorHarnessShadow)
cone = cone.fuse(motorHarness)
cone.Placement = App.Placement(App.Vector((loops.BoundBox.XMax+loops.BoundBox.XMin)/2,(loops.BoundBox.YMax+loops.BoundBox.YMin)/2,loops.BoundBox.ZMax), App.Rotation(0,0,0))
#fuse it here, later fuse in other random parts for printability
output = loop.fuse(loop2).fuse(loop3).fuse(loop4).fuse(loop5).fuse(loop6).fuse(loop7).fuse(connectorLoop).fuse(connectorLoop2).fuse(cone)

#now make arm to turn on pipes
circle = Part.makeCylinder(9,14) #adds 10 to 50 
axle = Part.makeCylinder(2.5,40)
circle = circle.cut(axle)
donut = Part.makeTorus(circle.BoundBox.XMax+2,3) #avoid scraping/catching on bottom and top of loop
donut.Placement = App.Placement(App.Vector(0,0,circle.BoundBox.ZMax+1), App.Rotation(0,0,0))
circle = circle.cut(donut)
#donut = Part.makeTorus(circle.BoundBox.XMax,1) #add a donut to top/bottom to keep on track
#donut.Placement = App.Placement(App.Vector(0,0,circle.BoundBox.ZMax), App.Rotation(0,0,0))
#circleCut = Part.makeBox(100,100,100)
#circleCut.Placement = App.Placement(App.Vector(-30,-30,circle.BoundBox.ZMax), App.Rotation(0,0,0))
#circle = circle.fuse(donut)
#circle = circle.cut(circleCut)
donut = Part.makeTorus(9,1) #add a donut to top/bottom to keep on track
donut.Placement = App.Placement(App.Vector(0,0,circle.BoundBox.ZMin), App.Rotation(0,0,0))
circleCut = Part.makeBox(100,100,100)
circleCut.Placement = App.Placement(App.Vector(-30,-30,0), App.Rotation(0,0,0))
circleCut.Placement = App.Placement(App.Vector(-30,-30,-circleCut.BoundBox.ZMax), App.Rotation(0,0,0))
circle = circle.fuse(donut)
circle = circle.cut(circleCut)
arm = Part.makeBox(11,26,14)
armCut = Part.makeBox(3,15,12)
armCut.Placement = App.Placement(App.Vector(2,0,2), App.Rotation(0,0,0))
arm = arm.cut(armCut)
screwCut = Part.makeCylinder(1.4,20)
screwCut.Placement = App.Placement(App.Vector(-1,3,8), App.Rotation(0,90,0))
arm = arm.cut(screwCut)
screwCut.Placement = App.Placement(App.Vector(-1,3+9,8), App.Rotation(0,90,0))
arm = arm.cut(screwCut)
arm2 = Part.makeBox(circle.BoundBox.ZMax+6,20,arm.BoundBox.ZMax) #this holds the circle
arm2Cut = Part.makeBox(circle.BoundBox.ZMax,100,arm2.BoundBox.ZMax)
#add keeper lip to keep bottom of arm below loops
#keeper = Part.makeBox((arm2.BoundBox.XMax-arm2Cut.BoundBox.XMax)/2,10,arm2.BoundBox.ZMax)
arm2Cut.Placement = App.Placement(App.Vector(3,arm2.BoundBox.YMin+3,0), App.Rotation(0,0,0))
arm2 = arm2.cut(arm2Cut)
axle.Placement = App.Placement(App.Vector(-1,arm2.BoundBox.YMax-4,arm2.BoundBox.ZMax/2), App.Rotation(0,90,0))
arm2 = arm2.cut(axle)
#keeper.Placement = App.Placement(App.Vector(arm2.BoundBox.XMin,arm2.BoundBox.YMax,0), App.Rotation(0,0,0))
#arm2 = arm2.fuse(keeper)
#make keeper into a wedge shape
#keeperWedgeCut = Part.makeBox(40,40,40)
#keeperWedgeCut.Placement = App.Placement(App.Vector(arm2Cut.BoundBox.XMin+0,arm2Cut.BoundBox.YMin,arm2.BoundBox.ZMax-3), App.Rotation(0,-45,0))
#arm2 = arm2.cut(keeperWedgeCut)
#keeperWedgeCut.Placement = App.Placement(App.Vector(arm2Cut.BoundBox.XMin+0,arm2Cut.BoundBox.YMin,-arm2.BoundBox.ZMax-7-keeperWedgeCut.BoundBox.XMax), App.Rotation(0,-45,0))
#arm2 = arm2.cut(keeperWedgeCut)
#keeperWedgeCut.Placement = App.Placement(App.Vector(arm2Cut.BoundBox.XMin+0,axle.BoundBox.YMax+2,0), App.Rotation(14,0,0))
#arm2 = arm2.cut(keeperWedgeCut)
arm2.Placement = App.Placement(App.Vector(arm.BoundBox.XMax/2-arm2.BoundBox.XMax/2-0.5,arm.BoundBox.YMax,0), App.Rotation(0,0,0))

arm3 = Part.makeBox(arm.BoundBox.XMax,26,arm.BoundBox.ZMax) #this continuest the arm and connects both sides of servo arm to this implement
armCut = Part.makeBox(3,arm3.BoundBox.YMax,12)
armCut.Placement = App.Placement(App.Vector(2,2,2), App.Rotation(0,0,0))
arm3 = arm3.cut(armCut)
screwCut.Placement = App.Placement(App.Vector(-1,4,8), App.Rotation(0,90,0))
arm3 = arm3.cut(screwCut)
screwCut.Placement = App.Placement(App.Vector(-1,4+9,8), App.Rotation(0,90,0))
arm3 = arm3.cut(screwCut)
arm3ScrewCut = Part.makeCylinder(5,30)
arm3ScrewCut.Placement = App.Placement(App.Vector(arm3.BoundBox.XMax-20,arm3.BoundBox.YMax-5,8), App.Rotation(0,90,0))
arm3 = arm3.cut(arm3ScrewCut)
arm3ScrewCut2 = Part.makeBox(2,10,12)
arm3ScrewCut2.Placement = App.Placement(App.Vector(0,arm3.BoundBox.YMax-10,2+5), App.Rotation(0,0,0))
arm3 = arm3.cut(arm3ScrewCut2)
arm3.Placement = App.Placement(App.Vector(0,arm.BoundBox.YMin-arm3.BoundBox.YMax,0), App.Rotation(0,0,0))


arm = arm.fuse(arm2).fuse(arm3)
circle.Placement = App.Placement(App.Vector(35,20,0), App.Rotation(0,0,0))
arm = arm.fuse(circle)
arm.Placement =  App.Placement(App.Vector(80,80,0), App.Rotation(0,0,0))
#Part.show(arm)

##############make manifold 7:1, 1 source. #############
manifold = Part.makeCylinder(120,11)
manifoldCut = Part.makeCylinder(manifold.BoundBox.XMax-20,manifold.BoundBox.ZMax)
manifold = manifold.cut(manifoldCut)
manifoldInner = Part.makeCylinder(manifold.BoundBox.XMax-2,manifold.BoundBox.ZMax-2)
manifoldInnerCut = Part.makeCylinder(manifold.BoundBox.XMax-18,manifoldInner.BoundBox.ZMax)
manifoldInner = manifoldInner.cut(manifoldInnerCut)
manifoldInner.Placement = App.Placement(App.Vector(0,0,2), App.Rotation(0,0,0))
manifold = manifold.cut(manifoldInner)
manifoldTop = Part.makeTorus(120-10,10)
manifoldTopCut = Part.makeBox(1000,1000,1000)
manifoldTopCut.Placement = App.Placement(App.Vector(-500,-500,-manifoldTopCut.BoundBox.ZMax), App.Rotation(0,0,0))
manifoldTop = manifoldTop.cut(manifoldTopCut)
manifoldTopCut2 = Part.makeTorus(120-10,7)
manifoldTop = manifoldTop.cut(manifoldTopCut2)
manifoldTop.Placement = App.Placement(App.Vector(0,0,manifold.BoundBox.ZMax), App.Rotation(0,0,0))
#add center.   
maniCenter = Part.makeCylinder(manifold.BoundBox.XMax-35,5)
#join the center to the edge ring
maniOutCenterConnector = Part.makeBox(manifold.BoundBox.XMax-10,10,2)
maniOutCenterConnectorAngles = [0,45,90,135,180,-45,-90,-135]
for angle in maniOutCenterConnectorAngles:
  maniOutCenterConnector.Placement = App.Placement(App.Vector(0,0,0), App.Rotation(0,0,0)) #flatten out first
  maniOutCenterConnector.Placement = App.Placement(App.Vector(0,0,0), App.Rotation(angle,0,0))
  maniCenter = maniCenter.fuse(maniOutCenterConnector)
#Then add solenoid holes (26,26 square).
manifoldScrewCut = Part.makeCylinder(2.5,10)
manifoldScrewCut.Placement = App.Placement(App.Vector(0,0+50,0), App.Rotation(0,0,0))
maniCenter = maniCenter.cut(manifoldScrewCut)
manifoldScrewCut.Placement = App.Placement(App.Vector(0,26+50,0), App.Rotation(0,0,0))
maniCenter = maniCenter.cut(manifoldScrewCut)
manifoldScrewCut.Placement = App.Placement(App.Vector(26,0+50,0), App.Rotation(0,0,0))
maniCenter = maniCenter.cut(manifoldScrewCut)
manifoldScrewCut.Placement = App.Placement(App.Vector(26,26+50,0), App.Rotation(0,0,0))
maniCenter = maniCenter.cut(manifoldScrewCut)
#holes for Motor (80,55).
manifoldScrewCut = Part.makeCylinder(3.0,10)
manifoldScrewCut.Placement = App.Placement(App.Vector(0-60,0-40,0), App.Rotation(0,0,0))
maniCenter = maniCenter.cut(manifoldScrewCut)
manifoldScrewCut.Placement = App.Placement(App.Vector(0-60,80-40,0), App.Rotation(0,0,0))
maniCenter = maniCenter.cut(manifoldScrewCut)
manifoldScrewCut.Placement = App.Placement(App.Vector(55-60,0-40,0), App.Rotation(0,0,0))
maniCenter = maniCenter.cut(manifoldScrewCut)
manifoldScrewCut.Placement = App.Placement(App.Vector(55-60,80-40,0), App.Rotation(0,0,0))
maniCenter = maniCenter.cut(manifoldScrewCut)
#esc x2 (9)
manifoldScrewCut = Part.makeCylinder(1.5,10)
manifoldScrewCut.Placement = App.Placement(App.Vector(-17+40,0,0), App.Rotation(0,0,0))
maniCenter = maniCenter.cut(manifoldScrewCut)
manifoldScrewCut.Placement = App.Placement(App.Vector(-6+40,0,0), App.Rotation(0,0,0))
maniCenter = maniCenter.cut(manifoldScrewCut)
manifoldScrewCut.Placement = App.Placement(App.Vector(6+40,0,0), App.Rotation(0,0,0))
maniCenter = maniCenter.cut(manifoldScrewCut)
manifoldScrewCut.Placement = App.Placement(App.Vector(17+40,0,0), App.Rotation(0,0,0))
maniCenter = maniCenter.cut(manifoldScrewCut)
#pi (12,47.5 square)
manifoldScrewCut = Part.makeCylinder(1.5,10)
manifoldScrewCut.Placement = App.Placement(App.Vector(-35,65,0), App.Rotation(0,0,0))
maniCenter = maniCenter.cut(manifoldScrewCut)
manifoldScrewCut.Placement = App.Placement(App.Vector(-35+12,65,0), App.Rotation(0,0,0))
