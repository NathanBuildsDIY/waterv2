barbShadowCut.Placement = App.Placement(App.Vector(manifoldOut.BoundBox.XMax/1.41-tubeOutideRadius-.5,manifoldOut.BoundBox.YMax/1.41-tubeOutideRadius-.5,0), App.Rotation(0,0,0)); manifoldOut = manifoldOut.cut(barbShadowCut)
