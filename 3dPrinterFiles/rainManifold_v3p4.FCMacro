################also make an input from pump to hose with barbIn############
radius = 10.6
inputConnector = Part.makeCylinder(13,14)
inputConnectorcut = Part.makeCylinder(radius,inputConnector.BoundBox.ZMax-4)
inputConnector = inputConnector.cut(inputConnectorcut)
inputWaterCut = Part.makeCylinder(4,inputConnector.BoundBox.ZMax)
inputConnector = inputConnector.cut(inputWaterCut)
barbInputConnector.Placement = App.Placement(App.Vector(0,0,inputConnector.BoundBox.ZMax+barbInputConnector.BoundBox.ZMax), App.Rotation(0,180,0))
inputConnector = inputConnector.fuse(barbInputConnector)

if fastcompile == False:
  #make threads to screw into
  pitch = 1.7
   #inputconnectorcut - a bit
  threadThickness = 0.8
  helix = Part.makeHelix(pitch,8,radius) #pitch, height, radius
  thread_profile = Part.Wire(Part.makePolygon([App.Vector(radius,0,0),App.Vector(radius-threadThickness,0,pitch/3),App.Vector(radius,0,2*pitch/3),App.Vector(radius,0,0)]))
    #note this is a Part.wire, polygon i.e. W0 = Part.Wire([edge0, edge1, edge2]) where edge0=Part.makeLine(ps0,ps1)
    #refs - https://forum.freecad.org/viewtopic.php?t=65875    https://forum.freecad.org/viewtopic.php?t=51032
    #note we have to complete the app.vector triangle - 4 points total so it connects back wehre it starts.
  makeSolid = True; isFrenet = True; transition = 1; 
  threads = Part.Wire(helix).makePipeShell([thread_profile],makeSolid,isFrenet)
outputConnector = inputConnector.copy()
inputConnector.Placement = App.Placement(App.Vector(100,150,inputConnector.BoundBox.ZMax), App.Rotation(0,180,0))
outputConnector.Placement = App.Placement(App.Vector(130,150,inputConnector.BoundBox.ZMax), App.Rotation(0,180,0))
if fastcompile == False:
  threads.Placement = App.Placement(App.Vector(100,150,inputConnector.BoundBox.ZMax), App.Rotation(0,180,0))
  inputConnector = inputConnector.fuse(threads); 
  threads.Placement = App.Placement(App.Vector(0,0,0), App.Rotation(0,0,0))
  threads.Placement = App.Placement(App.Vector(130,150,outputConnector.BoundBox.ZMax), App.Rotation(0,180,0))
  outputConnector = outputConnector.fuse(threads)

########now make output manifold - this is bottom connected to ring#####
